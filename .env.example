# =============================================================================
# External (partner) API — /api/ext/v1
# =============================================================================
# These three are the only variables the external API adds. Everything else the
# app needs (MONGODB_URI, CLOUDINARY_*, JWT_SECRET, ADMIN_*, AI_API_*) is
# unchanged and is not repeated here.

# HMAC secret used to sign the short-lived signature-proxy tokens embedded in
# instructors[].signature_url.
#
# FALLBACK: if this is empty, the app falls back to JWT_SECRET.
# CONSEQUENCE: while relying on that fallback, rotating JWT_SECRET immediately
# invalidates every outstanding signature URL — partners holding a cached
# signature_url will get 401 signature_token_invalid until they re-fetch the
# class. Set EXT_SIGNATURE_SECRET explicitly so signature tokens and admin
# sessions can be rotated independently.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXT_SIGNATURE_SECRET=

# Lifetime of a signature URL, in seconds. Default 900 (15 minutes) when unset
# or not a positive number. Partners must treat signature_url as short-lived and
# re-fetch the class rather than caching the URL.
EXT_SIGNATURE_TTL_SEC=900

# Absolute host used to build instructors[].signature_url.
# When empty the app falls back to NEXT_PUBLIC_BASE_URL, then to the Vercel
# deployment URL, then to the incoming request Host header. Set this in
# production so the emitted URL is always the stable public host over https.
EXT_PUBLIC_BASE_URL=https://register.9expert.app
